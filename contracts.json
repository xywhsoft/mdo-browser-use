{
  "version": 1,
  "services": [
    {
      "id": "browseruse.tabs",
      "description": "List, inspect, create, reveal or close browser tabs owned by the calling extension and task. Creating a record does not prove a native page has loaded.",
      "callback": "BuTabs",
      "effects": "MDO_TOOL_EFFECT_READ | MDO_TOOL_EFFECT_EXTERNAL_SERVICE",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "action": {"type": "string", "enum": ["list", "get", "create", "reveal", "close"]},
          "browser": {"type": "string", "minLength": 1, "maxLength": 100},
          "client": {"type": "string", "minLength": 1, "maxLength": 128},
          "url": {"type": "string", "minLength": 1, "maxLength": 8192},
          "key": {"type": "string", "minLength": 1, "maxLength": 200},
          "title": {"type": "string", "maxLength": 256}
        }
      },
      "output": {"type": "object"}
    },
    {
      "id": "browseruse.observe",
      "description": "Queue a bounded page observation in the tab's display client. Read browseruse.result to obtain the terminal observation; pending is not success.",
      "callback": "BuObserve",
      "effects": "MDO_TOOL_EFFECT_READ",
      "input": {
        "type": "object", "additionalProperties": false, "required": ["browser"],
        "properties": {
          "browser": {"type": "string", "minLength": 1, "maxLength": 100},
          "mode": {"type": "string", "enum": ["readable", "interactive"]},
          "limit": {"type": "integer", "minimum": 1, "maximum": 400},
          "max_bytes": {"type": "integer", "minimum": 256, "maximum": 32768},
          "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000}
        }
      },
      "output": {"type": "object"}
    },
    {
      "id": "browseruse.result",
      "description": "Read or release an owned Browser Use UI receipt without exposing its stored request. A failed page result stays failed even when transport delivery succeeded.",
      "callback": "BuResult",
      "effects": "MDO_TOOL_EFFECT_READ",
      "input": {
        "type": "object", "additionalProperties": false, "required": ["id"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "release": {"type": "boolean"}
        }
      },
      "output": {"type": "object"}
    }
  ]
}
