    static final class MdoBrowserDocument {
        static final int BACKGROUND=1,CHOOSER=2,MANUAL=4,NAVIGATION=16;static Runnable profileHook;int closes,destroyed,worldQueries,blocks;boolean working,closed,assigned;final Object view;Runnable complete;
        void block(int reason,boolean value){if(reason!=CHOOSER&&reason!=NAVIGATION&&reason!=MANUAL)throw new AssertionError("Unexpected controlled document block");blocks++;}
        void navigation(){}void committed(){}void loaded(){}
        boolean worldInstalled(){worldQueries++;return assigned&&!closed;}boolean ready(){worldQueries++;return assigned&&!closed;}
        String phase(){worldQueries++;return ready()?"ready":"world_unavailable";}int pending(){worldQueries++;return 0;}int outstanding(){worldQueries++;return 0;}String identity(){worldQueries++;return "fd-00000000-0000-4000-8000-000000000001";}
        void evaluate(String expected,String expression,long timeout,MdoBrowserWorld.Completion callback)throws MdoBrowserWorld.Failure {worldQueries++;throw new MdoBrowserWorld.Failure("controlled_legacy_evaluation");}
        MdoBrowserDocument(Object view){this.view=view;}
        static MdoBrowserDocument prepare(Object view,java.util.function.BooleanSupplier owned,java.util.function.LongSupplier epoch){return new MdoBrowserDocument(view);}
        void whenInitialized(Runnable callback){complete=callback;}boolean initializing(){return working;}
        boolean profileAssigned(){return assigned&&!closed&&!working;}
        void initializeInheritedProfile(ClassLoader loader,MdoBrowserDocument parent,Object opener,java.util.function.BooleanSupplier admission)throws MdoBrowserWorld.Failure {
            working=true;try{if(parent.view!=opener||!parent.profileAssigned())throw new MdoBrowserWorld.Failure("browser_profile_source_invalid");if(!admission.getAsBoolean())throw new MdoBrowserWorld.Failure("frame_changed");assigned=true;
                Runnable hook=profileHook;profileHook=null;if(hook!=null)hook.run();if(closed||!parent.profileAssigned()||!admission.getAsBoolean())throw new MdoBrowserWorld.Failure("frame_changed");}
            finally{working=false;Runnable callback=complete;complete=null;if(callback!=null)callback.run();}
        }
