    int networkRetiring(){int count=networkReady?0:1;for(NetworkEntry row:networkViews.values())if(row.draining||row.retired&&!row.protocolDrained)count++;return count;}
    int downloadRetiring(){int count=0;for(NetworkEntry row:networkViews.values())if(row.downloads!=null)count+=row.downloads.retiringFiles();return count;}
    boolean networkClean(){return networkReady&&!networkCleanupFailed&&networkRetiring()==0&&downloadRetiring()==0;}
