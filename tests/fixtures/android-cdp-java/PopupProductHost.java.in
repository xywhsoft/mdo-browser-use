    boolean deferOwnedPreparationWatch(String key)throws Exception {
        PopupPreparation row=protocolPopupPreparations.get(key);if(row==null||!row.preparation.phase().equals("ready"))return false;
        java.lang.reflect.Field field=MdoBrowserCdpPopupPreparation.class.getDeclaredField("watch");field.setAccessible(true);networkHandler.removeCallbacks((Runnable)field.get(row.preparation));return true;
    }
    boolean ownedPreparationSettled(String key){PopupPreparation row=protocolPopupPreparations.get(key);return row==null||row.preparation.settled();}
    String ownedPreparationDiagnostic(String key)throws Exception{PopupPreparation row=protocolPopupPreparations.get(key);if(row==null)return "none";
        java.lang.reflect.Field request=MdoBrowserCdpPopupPreparation.class.getDeclaredField("request");request.setAccessible(true);
        MdoBrowserCdpPopupWorker.Request saved=(MdoBrowserCdpPopupWorker.Request)request.get(row.preparation);MdoBrowserCdpPopupWorker.Result result=saved==null?null:saved.result();
        java.lang.reflect.Field source=MdoBrowserCdpPopupPreparation.class.getDeclaredField("source");source.setAccessible(true);MdoBrowserCdpPopupNative nativeSource=(MdoBrowserCdpPopupNative)source.get(row.preparation);
        StringBuilder detail=new StringBuilder();for(String name:new String[]{"claimed","released","scope","stop","destroyedSource"}){java.lang.reflect.Field field=MdoBrowserCdpPopupNative.class.getDeclaredField(name);field.setAccessible(true);Object value=field.get(nativeSource);detail.append(" ").append(name).append("=").append(value);
            if(name.equals("destroyedSource")&&value!=null){java.lang.reflect.Field settled=value.getClass().getDeclaredField("nativeSettled");settled.setAccessible(true);detail.append(" settled=").append(settled.get(value));}}
        return row.preparation.phase()+" "+row.preparation.failure()+" native="+nativeSource.failure()+" pending="+nativeSource.rejectionPending()+" confirmed="+nativeSource.confirmed()+" released="+nativeSource.released()+detail+" result="+(result==null?"pending":result.code+" released="+result.sourceReleased+" clean="+result.processCleanupConfirmed);}
