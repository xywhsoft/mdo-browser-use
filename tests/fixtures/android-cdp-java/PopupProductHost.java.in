    static final class Root {
        int removes,adds;Runnable callback,adding;boolean failAdd;final Set<WebView> children=Collections.newSetFromMap(new IdentityHashMap<WebView,Boolean>());
        void addView(WebView exact){if(!children.add(exact))throw new AssertionError("Duplicate native UI child");adds++;Runnable work=adding;adding=null;if(work!=null)work.run();if(failAdd)throw new IllegalStateException("controlled_root_add_failure");}
        void removeView(WebView exact){children.remove(exact);removes++;Runnable work=callback;callback=null;if(work!=null)work.run();}
    }
    static final class CdpViews {
        int invalidations;MdoBrowserCdpWorker worker;
        final MdoBrowserCdpRegistry<WebView> registry=new MdoBrowserCdpRegistry<>((view,quota,current)->new MdoBrowserCdpView(view,v->v==view&&current.getAsBoolean(),quota).marker(),lease->{if(worker!=null)worker.cancel(lease);});
        MdoBrowserCdpMarker marker(String key,WebView view,long epoch,Object channel,java.util.function.BooleanSupplier current){return registry.marker(key,view,epoch,channel,current);}
        MdoBrowserCdpMarker existing(String key,WebView view,long epoch,Object channel){return registry.existing(key,view,epoch,channel);}
        void invalidate(String key,WebView exact,long epoch,String reason){invalidations++;registry.invalidate(key,exact,epoch,reason);}
    }
    static final class MdoBrowserWorld {
        static final class Failure extends Exception {final String code;Failure(String code){this.code=code;}}
        static final class Result {boolean ok,evaluationMayHaveOccurred;String value,code;}
        interface Completion {void complete(Result result);}
    }
    static final class MdoBrowserDocument {
        static final int BACKGROUND=1;static Runnable profileHook;int closes,destroyed,worldQueries;boolean working,closed,assigned;final Object view;Runnable complete;
        boolean worldInstalled(){worldQueries++;return assigned&&!closed;}boolean ready(){worldQueries++;return assigned&&!closed;}
        String phase(){worldQueries++;return ready()?"ready":"world_unavailable";}int pending(){worldQueries++;return 0;}int outstanding(){worldQueries++;return 0;}String identity(){worldQueries++;return "fd-00000000-0000-4000-8000-000000000001";}
        void evaluate(String expected,String expression,long timeout,MdoBrowserWorld.Completion callback)throws MdoBrowserWorld.Failure {worldQueries++;throw new MdoBrowserWorld.Failure("controlled_legacy_evaluation");}
        MdoBrowserDocument(Object view){this.view=view;}
        static MdoBrowserDocument prepare(Object view,java.util.function.BooleanSupplier owned,java.util.function.LongSupplier epoch){return new MdoBrowserDocument(view);}
        void whenInitialized(Runnable callback){complete=callback;}boolean initializing(){return working;}
        boolean profileAssigned(){return assigned&&!closed&&!working;}
        void initializeInheritedProfile(ClassLoader loader,MdoBrowserDocument parent,Object opener,java.util.function.BooleanSupplier admission)throws MdoBrowserWorld.Failure {
            working=true;try{if(parent.view!=opener||!parent.profileAssigned())throw new MdoBrowserWorld.Failure("browser_profile_source_invalid");if(!admission.getAsBoolean())throw new MdoBrowserWorld.Failure("frame_changed");assigned=true;
                Runnable hook=profileHook;profileHook=null;if(hook!=null)hook.run();if(closed||!parent.profileAssigned()||!admission.getAsBoolean())throw new MdoBrowserWorld.Failure("frame_changed");}
            finally{working=false;Runnable callback=complete;complete=null;if(callback!=null)callback.run();}
        }
        boolean cleanupConfirmed(){return !working;}void close(){closes++;closed=true;}void viewDestroyed(WebView exact){if(exact!=view||working)throw new AssertionError("Unsettled/foreign profile owner");destroyed++;}
    }
