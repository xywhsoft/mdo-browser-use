    void enableUpload(String key,java.nio.file.Path directory)throws Exception {
        if(uploads!=null)throw new AssertionError("Duplicate shared file worker");
        if(java.nio.file.Files.exists(directory,java.nio.file.LinkOption.NOFOLLOW_LINKS))verifyFileDirectory(directory);else java.nio.file.Files.createDirectory(directory);
        uploads=new MdoBrowserUploadQueue(()->{MdoBrowserUploadFiles files=new MdoBrowserUploadFiles(directory);files.acquireCacheLease();return files;},task->new android.os.Handler(android.os.Looper.getMainLooper()).post(task),android.os.SystemClock::elapsedRealtime);
        WebView view=views.get(key);if(view==null)throw new AssertionError("Original popup missing");MdoBrowserDialogTarget old=dialogs.get(key);if(old!=null)old.close();dialogs.put(key,new MdoBrowserChooserTarget(key,view));uploadQualified=true;
    }
    void uploadRpc(String key,String id,JSONObject request)throws Exception{executeUpload(key,id,views.get(key),request);}
    MdoBrowserUploadStore.Scope retainUploadScope(String key){
        WebView view=views.get(key);UploadEntry original=new UploadEntry(view,views.epoch(key,view),uploadData(key,view));
        if(uploadOwners.put(key,original)!=null)throw new AssertionError("Existing upload scope replaced");return original.scope;
    }
    boolean retainedUploadDataLive(String key){UploadDataEntry original=uploadDataOwners.get(key);return original!=null&&original.owner.live();}
    MdoBrowserUploadUris fileUris(){return new MdoBrowserUploadUris(uploads,android.os.SystemClock::elapsedRealtime);}
    int uploadFiles(){return uploads==null?0:uploads.activeFiles();}
    int uploadBooks(){return uploadBooks.size();}
    private static void verifyFileDirectory(java.nio.file.Path directory)throws Exception {
        if(java.nio.file.Files.isSymbolicLink(directory)||!java.nio.file.Files.isDirectory(directory,java.nio.file.LinkOption.NOFOLLOW_LINKS))throw new AssertionError("Unknown popup cache preserved");
        try(java.nio.file.DirectoryStream<java.nio.file.Path> rows=java.nio.file.Files.newDirectoryStream(directory)){
            for(java.nio.file.Path row:rows){if(!row.getFileName().toString().equals(MdoBrowserUploadFiles.OWNER_FILE)||java.nio.file.Files.isSymbolicLink(row)||
                    !java.util.Arrays.equals(java.nio.file.Files.readAllBytes(row),"mdo-browser-use-private-upload-cache-v1\n".getBytes(java.nio.charset.StandardCharsets.UTF_8)))throw new AssertionError("Unknown popup cache file preserved");}
        }
    }
    void openPicker(String key,MdoBrowserPrivatePicker.Response response)throws Exception {
        MdoBrowserChooserTarget target=(MdoBrowserChooserTarget)dialogs.get(key);
        if(!target.privatePicker.open(views.get(key),new Object(),response,1,new String[]{"application/x-mdo-browseruse-00000000000000000000000000000001"},false))throw new AssertionError("Original popup picker callback was not claimed");
    }
    void stopUpload(java.nio.file.Path directory)throws Exception {
        if(uploads==null)return;cancelUploads();uploads.close();if(!uploads.awaitStopped(5000))throw new AssertionError("Original popup file worker did not retire");android.os.Handler.drain();
        if(uploadFiles()!=0||uploadBooks()!=0)throw new AssertionError("Popup file authority retained after native destruction");
        // Keep only the verified ownership marker in this one reusable QA
        // directory. No per-case cache copies or directory replacement.
        verifyFileDirectory(directory);
    }
    static final class Capture {
        boolean active,clean=true;final MdoBrowserCapture original;
        Capture(MdoBrowserCapture original){this.original=original;}
        boolean busy(){return original==null?active:original.busy();}
        boolean cleanupConfirmed(){return original==null?clean:original.cleanupConfirmed();}
        void cancel(){if(original==null)close();else original.cancel();}
        void close(){if(original==null){active=false;clean=true;}else original.close();}
        void viewDestroyed(){if(original==null)close();else original.viewDestroyed();}
    }
    static final class CaptureEntry {
        final WebView view;final Capture capture;
        CaptureEntry(WebView view){this(view,null);}
        CaptureEntry(WebView view,MdoBrowserCapture original){this.view=view;capture=new Capture(original);}
    }
