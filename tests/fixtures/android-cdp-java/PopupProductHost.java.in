    final class MdoBrowserChooserTarget extends MdoBrowserDialogTarget {
        final MdoBrowserChoosers choosers;final MdoBrowserPrivatePicker privatePicker;
        MdoBrowserChooserTarget(String key,WebView view){super(view);android.os.Handler handler=new android.os.Handler(android.os.Looper.getMainLooper());
            choosers=new MdoBrowserChoosers(view,new MdoBrowserChoosers.Scheduler(){public long now(){return android.os.SystemClock.elapsedRealtime();}public void at(Runnable task,long due){handler.postDelayed(task,Math.max(0,due-now()));}public void remove(Runnable task){handler.removeCallbacks(task);}},
                ()->views.owns(key,view),()->views.epoch(key,view),blocked->chooserBlocked(key,view,blocked));
            privatePicker=new MdoBrowserPrivatePicker(view,choosers,new MdoBrowserPrivatePicker.Scheduler(){public long now(){return android.os.SystemClock.elapsedRealtime();}public void at(Runnable task,long due){handler.postDelayed(task,Math.max(0,due-now()));}public void remove(Runnable task){handler.removeCallbacks(task);}},
