final class AndroidCreateHost {
    static final class JSONException extends Exception {}
    static final class JSONObject {
        final Map<String,Object> data=new HashMap<>();
        JSONObject put(String key,Object value)throws JSONException{data.put(key,value);return this;}
        boolean has(String key){return data.containsKey(key);}
        String optString(String key){return optString(key,"");}
        String optString(String key,String fallback){Object value=data.get(key);return value instanceof String?(String)value:fallback;}
        boolean optBoolean(String key){return Boolean.TRUE.equals(data.get(key));}
    }
    static final class Bitmap {}
    static final class View {static final int INVISIBLE=4;}
    static final class WebMessagePort {}
    static class WebResourceRequest {boolean isForMainFrame(){return true;}Object getUrl(){return "https://fixture.invalid/";}}
