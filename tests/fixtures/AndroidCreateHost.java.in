    static class WebResourceResponse {int getStatusCode(){return 200;}}
    static class SslErrorHandler {void cancel(){}}
    static class RenderProcessGoneDetail {}
    static class WebViewClient {
        void onScaleChanged(WebView view,float before,float after){}
        void onPageStarted(WebView view,String url,Bitmap icon){}
        void onPageFinished(WebView view,String url){}
        void onReceivedError(WebView view,WebResourceRequest request,WebResourceError error){}
        void onReceivedSslError(WebView view,SslErrorHandler handler,android.net.http.SslError error){}
        void onReceivedHttpError(WebView view,WebResourceRequest request,WebResourceResponse response){}
        boolean shouldOverrideUrlLoading(WebView view,WebResourceRequest request){return false;}
        boolean onRenderProcessGone(WebView view,RenderProcessGoneDetail detail){return false;}
    }
    static final class WebSettings {
        static final int MIXED_CONTENT_NEVER_ALLOW=1;final WebView view;WebSettings(WebView view){this.view=view;}
        private void touch(){view.touches++;if(view.host.fault.equals("settings"))throw new IllegalStateException("fixture settings failure");}
        void setJavaScriptEnabled(boolean value){touch();}void setDomStorageEnabled(boolean value){touch();}
        void setAllowFileAccess(boolean value){touch();}void setAllowContentAccess(boolean value){touch();}
        void setMixedContentMode(int value){touch();}void setSupportMultipleWindows(boolean value){touch();}
        void setJavaScriptCanOpenWindowsAutomatically(boolean value){touch();}
    }
    static final class WebView {
        static final int INVISIBLE=4;final AndroidCreateHost host;int destroys,touches,loads;WebViewClient client;
        WebView(Object activity){host=(AndroidCreateHost)activity;host.created.add(this);}
        static ClassLoader getWebViewClassLoader(){return AndroidCreateHost.class.getClassLoader();}
        WebSettings getSettings(){return new WebSettings(this);}void setWebViewClient(WebViewClient client){this.client=client;}
        void loadUrl(String target){loads++;if(host.fault.equals("load"))throw new IllegalStateException("fixture navigation dispatch failure");}
        void setVisibility(int value){}
        void destroy(){destroys++;if(host.cleanupFault.equals("oom"))throw new OutOfMemoryError("fixture destroy allocation failure");if(host.fault.equals("destroy")||host.cleanupFault.equals("destroy"))throw new IllegalStateException("fixture destroy acknowledgement lost");}
    }
    static final class Root {
        final Set<WebView> children=Collections.newSetFromMap(new IdentityHashMap<WebView,Boolean>());int removes;
        Runnable beforeRemove;
        void addView(WebView view){children.add(view);if(view.host.fault.equals("attach"))throw new IllegalStateException("fixture attach acknowledgement lost");}
        void removeView(WebView view){removes++;Runnable hook=beforeRemove;beforeRemove=null;if(hook!=null)hook.run();if(view.host.cleanupFault.equals("detach"))throw new IllegalStateException("fixture detach failed");children.remove(view);}
    }
    static final class MdoBrowserWorld {
        static final class Failure extends Exception {final String code;Failure(String code){super(code);this.code=code;}}
        static final class Budget {Budget(int limit){}}
        interface Scheduler {long now();void post(Runnable task,long delay);void remove(Runnable task);}
    }
    static final class MdoBrowserDocument {
        final WebView view;int closes,destroyed;
        MdoBrowserDocument(Object raw,ClassLoader loader,MdoBrowserWorld.Scheduler scheduler,BooleanSupplier owned,LongSupplier epoch,String profile,MdoBrowserWorld.Budget budget)throws MdoBrowserWorld.Failure{
            view=(WebView)raw;view.host.profileRequests.add(profile);
            if(profile!=null||view.host.fault.equals("manual_world"))throw new MdoBrowserWorld.Failure(profile==null?"isolated_world_unsupported":"browser_profile_unconfirmed");
        }
        void block(int reason,boolean value){}void close(){closes++;}boolean cleanupConfirmed(){return !view.host.cleanupFault.equals("document");}
        void viewDestroyed(Object original){if(original!=view)throw new AssertionError("Wrong document view");destroyed++;}
        static final int BACKGROUND=1,CHANNEL=2;
    }
    static final class MdoBrowserChannel<T> {final class Lease {}final Lease lease=new Lease();Lease current(){return lease;}}
    static final class MdoBrowserPopups<T> {
        static final class Snapshot {String id="popup";}interface Done {void done(boolean ok,String code,boolean mayHaveOccurred);}
        int adopts,closes,destroyed;boolean deferred;Done pending;
        Snapshot snapshot(){return new Snapshot();}void adopt(String id,T view,Done done){adopts++;pending=done;if(!deferred)done.done(true,null,true);}
        void close(){closes++;}void viewDestroyed(T view){destroyed++;}
    }
    static final class PopupLink {final WebView view;final String opener,id;boolean ready;PopupLink(WebView view,String opener,String id){this.view=view;this.opener=opener;this.id=id;}}
    static final class DialogCore {boolean clean(){return true;}}
    static final class MdoBrowserDialogTarget {final WebView view;final DialogCore dialogs=new DialogCore();MdoBrowserDialogTarget(WebView view){this.view=view;}void close(){}void viewDestroyed(){}}
    static final class Capture {void close(){}void viewDestroyed(){}}
    static final class CaptureEntry {final WebView view;final Capture capture=new Capture();CaptureEntry(WebView view){this.view=view;}}
    static final class CdpViews {void invalidate(String key,WebView view,long epoch,String code){}}
    final Object activity=this;final Root root=new Root();final CdpViews cdpViews=new CdpViews();
    final MdoBrowserWorld.Budget worldBudget=new MdoBrowserWorld.Budget(32);final MdoBrowserChannel<WebMessagePort> channel=new MdoBrowserChannel<>();
    final List<WebView> created=new ArrayList<>();final List<String> profileRequests=new ArrayList<>();
    final Map<String,MdoBrowserDocument> documents=new HashMap<>();final Map<String,String> documentFailures=new HashMap<>();
    final Map<String,MdoBrowserPopups<WebView>> windows=new HashMap<>();final Map<String,PopupLink> popupLinks=new HashMap<>();
    final Map<String,MdoBrowserDialogTarget> dialogs=new HashMap<>();final Map<String,CaptureEntry> captures=new HashMap<>();
    final Map<String,Object> navigationRequests=new HashMap<>();final Map<String,Boolean> loading=new HashMap<>();
    final Map<String,String> errors=new HashMap<>(),locations=new HashMap<>();final Map<String,Integer> errorCodes=new HashMap<>();
    final Set<String> pageClosed=new HashSet<>(),crashed=new HashSet<>(),manual=new HashSet<>();
    boolean stopped,browserPaused;String fault="",cleanupFault="";int replies,retired;JSONObject lastReply;
    final MdoBrowserLifecycle<WebView> views=new MdoBrowserLifecycle<>((view,epoch,admitted)->{
        if(fault.equals("input"))throw new IllegalStateException("fixture input allocation failure");
        return new MdoBrowserInput(new MdoBrowserInput.Target(){
            public long document(){return epoch.getAsLong();}public int width(){return 100;}public int height(){return 100;}
            public boolean interactive(){return admitted.getAsBoolean();}public boolean focused(){return true;}
            public boolean touch(int action,long down,long now,float x,float y){return true;}
            public boolean key(boolean down,long started,long now,String key,int modifiers){return true;}public boolean text(String value){return true;}
        },new MdoBrowserInput.Scheduler(){public long now(){return 100;}public void post(Runnable task,long delay){}public void remove(Runnable task){}});
    });
    void bounds(WebView view,JSONObject request){if(fault.equals("bounds"))throw new IllegalStateException("fixture bounds failure");}
    String url(String value){return value;}void bindDialogs(String key,WebView view){dialogs.put(key,new MdoBrowserDialogTarget(view));}
    void cancelNavigationRequest(String key,WebView view){}void cancelCapture(String key){}
    void documentNavigation(String key,WebView view){}void documentLoaded(String key,WebView view){}void notifyPopup(String key){}
    void retireUploadData(WebView view){retired++;}
    void cancelUpload(String key,WebView view){}
    void reply(String id,JSONObject result,String error)throws JSONException{replies++;lastReply=result;if(fault.equals("reply"))throw new JSONException();}
    void reply(MdoBrowserChannel<WebMessagePort>.Lease lease,String id,JSONObject result,String error){replies++;lastReply=result;}
    private JSONObject browserUseSupport()throws JSONException{return new JSONObject().put("available",false);}
    boolean retire(String key,WebView view){return closeAndDestroyDocument(key,view);}
    boolean chooserClean(MdoBrowserDialogTarget target){return target==null||!cleanupFault.equals("chooser");}
    boolean closeCommand(String key){WebView web=views.get(key);@@CLOSE_COMMAND@@ return worldClean;}
