    void reply(MdoBrowserChannel<WebMessagePort>.Lease lease,String id,JSONObject result,String error){if(beforeScopedReply!=null){Runnable original=beforeScopedReply;beforeScopedReply=null;original.run();}if(channel.current()==lease&&channel.active(lease,host.getUrl())&&!stopped){replies++;lastReply=result;scopedIds.add(id);scopedResults.put(id,result);scopedErrors.put(id,error);}}
