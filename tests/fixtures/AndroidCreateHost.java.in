    static final class MdoBrowserCdpMarker {
        static final class DocumentQuota {boolean closed;void close(){closed=true;}}
        static final class Lease {boolean live=true;}final Lease lease=new Lease();final BooleanSupplier current;
        MdoBrowserCdpMarker(BooleanSupplier current){this.current=current;}Lease lease(){return lease;}void close(){lease.live=false;}
    }
    static final class MdoBrowserCdpView {
        interface Owner {boolean current(WebView view);}final MdoBrowserCdpMarker marker;
        MdoBrowserCdpView(WebView view,Owner owner){marker=new MdoBrowserCdpMarker(()->owner.current(view));}
        static MdoBrowserCdpView network(WebView view,Owner owner,MdoBrowserCdpMarker.DocumentQuota quota){return new MdoBrowserCdpView(view,owner);}
        MdoBrowserCdpMarker marker(){return marker;}
    }
    static class NativeConnection {int continued,downloads,turns;void continuePausedRequest(){continued++;}}
    static final class MdoBrowserCdpBinding {static final class Network extends NativeConnection {}}
    static final class MdoBrowserCdpNetworks {
        interface Events {void event(MdoBrowserCdpBinding.Network connection,String method,String child,JSONObject params)throws java.io.IOException;default void turn(MdoBrowserCdpBinding.Network connection)throws java.io.IOException {}}
        interface Completion {void done(Result result);}
        static final class Result {final boolean ready,cleanupConfirmed;boolean responsesDisabled;String code;Result(boolean ready,boolean clean){this.ready=ready;cleanupConfirmed=clean;}}
    }
    static final class MdoBrowserDownloadRuntime {
        final Object files=new Object(),budget=new Object();
        static MdoBrowserDownloadRuntime get(Object activity){if(((AndroidCreateHost)activity).fault.equals("download_service"))throw new IllegalStateException("fixture native authority unavailable");return new MdoBrowserDownloadRuntime();}
    }
    static final class MdoBrowserCdpDownloads {
        static MdoBrowserCdpDownloads latest;int retiring,quiesces;boolean closed,disconnected,pending;
        MdoBrowserCdpDownloads(Object files,Object budget){latest=this;}
        void event(MdoBrowserCdpBinding.Network connection,String method,String child,JSONObject params){connection.downloads++;}
        void turn(MdoBrowserCdpBinding.Network connection){connection.turns++;}
        void disconnect(){disconnected=true;}
        void quiesce(){quiesces++;}
        void close(){closed=true;}
        int retiringFiles(){return retiring;}
        boolean pending(){return pending;}String failure(){return null;}
    }
    static final class NetworkCall {
        final MdoBrowserCdpMarker marker;final MdoBrowserCdpNetworks.Events events;final MdoBrowserCdpNetworks.Completion complete;
        boolean pending=true;int cancelled,retired;NetworkCall(MdoBrowserCdpMarker marker,MdoBrowserCdpNetworks.Events events,MdoBrowserCdpNetworks.Completion complete){this.marker=marker;this.events=events;this.complete=complete;}
        void ready(){complete.done(new MdoBrowserCdpNetworks.Result(true,false));}
        void closed(boolean clean){pending=!clean;complete.done(new MdoBrowserCdpNetworks.Result(false,clean));}
        void failed(String code,boolean clean){pending=!clean;MdoBrowserCdpNetworks.Result result=new MdoBrowserCdpNetworks.Result(false,clean);result.code=code;complete.done(result);}
        void retired(){pending=false;MdoBrowserCdpNetworks.Result result=new MdoBrowserCdpNetworks.Result(false,true);result.code="cdp_network_retired";result.responsesDisabled=true;complete.done(result);}
    }
    static final class CdpWorker {
        final List<NetworkCall> calls=new ArrayList<>();boolean closed,failStart;
        void startNetwork(MdoBrowserCdpMarker marker,int timeout,MdoBrowserCdpNetworks.Events events,MdoBrowserCdpNetworks.Completion complete)throws java.io.IOException{
            if(failStart)throw new java.io.IOException("fixture start failure");if(!marker.current.getAsBoolean())throw new java.io.IOException("fixture owner lost");calls.add(new NetworkCall(marker,events,complete));
        }
        void cancelNetwork(MdoBrowserCdpMarker.Lease lease){for(NetworkCall call:calls)if(call.marker.lease==lease)call.cancelled++;}
        void retireNetwork(MdoBrowserCdpMarker.Lease lease){for(NetworkCall call:calls)if(call.marker.lease==lease)call.retired++;}
        boolean networkPending(MdoBrowserCdpMarker marker){for(NetworkCall call:calls)if(call.marker==marker)return call.pending;return false;}
        boolean terminated(){return closed;}
    }
    static final class MdoBrowserPopups<T> {
        static final class Snapshot {String id="popup";}interface Done {void done(boolean ok,String code,boolean mayHaveOccurred);}
        int adopts,closes,destroyed;boolean deferred;Done pending;
        Snapshot snapshot(){return new Snapshot();}void adopt(String id,T view,Done done){adopts++;pending=done;if(!deferred)done.done(true,null,true);}
        void close(){closes++;}void viewDestroyed(T view){destroyed++;}
    }
